# Rakuten Developers credentials (webservice.rakuten.co.jp). Free to obtain.
# Both are issued together when you register an app. As of Rakuten's 2026 API
# overhaul BOTH are required -- applicationId alone gets rejected. Still no
# OAuth: they're sent as plain query params (accessKey may also go in a header).
# The app registration also has an IP allowlist; ours is 0.0.0.0/0 because
# Vercel's free tier has no fixed outbound IP to pin.
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Neon Postgres connection string (neon.tech). Free tier.
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# Random secret you generate yourself. Guards POST /api/sync so only
# our own Vercel Cron job (not the public internet) can trigger a fetch.
CRON_SECRET=
